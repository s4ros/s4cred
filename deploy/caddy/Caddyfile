{
	admin off
	auto_https off
	log {
		output discard
	}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 30s
		}
	}
}

notes.example.com {
	bind 127.0.0.1
	tls /etc/s4cred/tls/fullchain.pem /etc/s4cred/tls/privkey.pem
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 1400000
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up -Forwarded
		header_up -X-Real-IP
		header_up -X-Forwarded-Prefix
		header_up -X-Forwarded-Client-Cert
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Server
		header_up -X-Forwarded-Uri
		header_up -X-Forwarded-Method
		header_up -X-Forwarded-Scheme
		header_up -X-Forwarded-Ssl
		header_up -X-Original-URL
		header_up -Idempotency-Key
		header_up -X-Idempotency-Key
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
